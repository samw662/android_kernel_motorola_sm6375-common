# bangkk-lineage config fragment, merged last by build_ram.sh

CONFIG_LOCALVERSION="—WearyStars⭐"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_WEARYSTARS=y

CONFIG_KSU=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# CONFIG_LRU_GEN is not set

# Low memory killer
CONFIG_ANDROID_SIMPLE_LMK=y
CONFIG_ANDROID_SIMPLE_LMK_MINFREE=128
CONFIG_ANDROID_SIMPLE_LMK_TIMEOUT_MSEC=200

# BPF kernel version spoof
CONFIG_FAKE_UNAME_5_10=y

# DroidSpaces: IPC fields use existing task_struct/user_struct ABI padding.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Nested sandboxing, IPv6 NAT and tmpfs metadata support.
CONFIG_USER_NS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Preserve the vendor cgroup layout and the existing WALT/EEVDF configuration.
# No CFS bandwidth or pids controller: DroidSpaces skips those optional limits.
# CONFIG_FAIR_GROUP_SCHED is not set
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_DEVICE is not set
